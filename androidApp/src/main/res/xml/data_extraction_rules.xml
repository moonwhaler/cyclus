<?xml version="1.0" encoding="utf-8"?>
<!-- Device backup (ANDROID_PLAN §6.4). The custom CyclusBackupAgent decides what is sent: the encrypted snapshot and
     its key, only over end-to-end encrypted backup or device-to-device transfer. These rules mirror that (they include
     exactly those two files) as defence in depth; the database, its key and preferences are never backed up. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
    <include domain="file" path="backup/snapshot.cyclus" />
    <include domain="file" path="backup/key.plain" />
    </cloud-backup>
    <device-transfer>
    <include domain="file" path="backup/snapshot.cyclus" />
    <include domain="file" path="backup/key.plain" />
    </device-transfer>
</data-extraction-rules>
